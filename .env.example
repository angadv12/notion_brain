# notion_brain Environment Variables

# =====================
# REQUIRED VARIABLES
# =====================

# Notion Integration
NOTION_TOKEN=your_notion_token_here
NOTION_DATA_SOURCE_ID=your_data_source_id_here

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# =====================
# OPTIONAL: NOTIFICATIONS
# =====================

# Twilio SMS (for SMS notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
USER_PHONE_NUMBER=+0987654321

# Telegram (for Telegram notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# =====================
# OPTIONAL: BEHAVIOR
# =====================

# Notification Settings
NOTIFICATION_ENABLED=true
NOTIFICATION_CHANNELS=sms

# Quiet Hours (suppress notifications during these hours)
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00

# Timezone (for all date/time operations)
TIMEZONE=America/New_York
